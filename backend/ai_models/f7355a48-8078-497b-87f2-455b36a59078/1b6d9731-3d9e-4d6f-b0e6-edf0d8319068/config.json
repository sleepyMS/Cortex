{
  "sequence_length": 60,
  "feature_order": [
    "open",
    "high",
    "low",
    "close",
    "volume",
    "returns",
    "log_returns",
    "EMA_20",
    "MACD_12_26_9",
    "MACDh_12_26_9",
    "MACDs_12_26_9",
    "RSI_14"
  ],
  "normalization": {

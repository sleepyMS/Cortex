      "type": "EMA",
      "params": {
        "length": 20
      }
    },
    {
      "type": "MACD",
      "params": {
        "fast": 12,
        "slow": 26,
        "signal": 9
      }
    },
    {
      "type": "RSI",
      "params": {
        "length": 14
      }
    }
  ],
  "use_ohlcv": true,
  "ohlcv_columns": [
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "use_returns": true,
  "use_log_returns": true
}
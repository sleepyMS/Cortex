{
  "sequence_length": 60,
  "feature_order": [
    "open",
    "high",
    "low",
    "close",
    "volume",
    "returns",
    "log_returns",
    "RSI_14",
    "MACD_12_26_9",
    "MACDh_12_26_9",
    "MACDs_12_26_9",
    "BBL_20_2.0",
    "BBM_20_2.0",
    "BBU_20_2.0",
    "BBB_20_2.0",
    "BBP_20_2.0",
    "EMA_20"
  ],
  "normalization": {
    "method": "rolling_zscore",
    "rolling_window": 100,
    "params": {}
  },
  "indicators": [
    {
      "type": "RSI",
      "params": {
        "period": 14
      }
    },
    {
      "type": "MACD",
      "params": {
        "fast": 12,
        "slow": 26,
        "signal": 9
      }
    },
    {
      "type": "BB",
      "params": {
        "std": 2,
        "period": 20
      }
    },
    {
      "type": "EMA",
      "params": {
        "length": 20
      }
    }
  ],
  "use_ohlcv": true,
  "ohlcv_columns": [
    "open",
    "high",
    "low",
    "close",
    "volume"
  ],
  "use_returns": true,
  "use_log_returns": true
}